{
  "name": "pactkit-dsh",
  "version": "0.1.0",
  "description": "PactKit governance for DeepSeek Harness: host-enforced pre-tool gates plus native access to the pactkit CLI.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pactkit",
    "governance",
    "gates",
    "spec-driven",
    "devops"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
